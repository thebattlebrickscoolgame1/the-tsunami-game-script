local function addLog(message, isError)

    if not LogsFrame then
        return
    end

    local log = Instance.new("TextLabel")

    log.Size = UDim2.new(1, -10, 0, 24)
    log.BackgroundTransparency = 1
    log.Text = os.date("[%H:%M:%S] ") .. tostring(message)

    if isError then
        log.TextColor3 = Color3.fromRGB(255, 90, 90)
    else
        log.TextColor3 = Color3.fromRGB(220, 220, 220)
    end

    log.TextSize = 12
    log.Font = Enum.Font.Code
    log.TextXAlignment = Enum.TextXAlignment.Left
    log.TextWrapped = true
    log.ZIndex = 10
    log.Parent = LogsFrame

    LogsFrame.CanvasPosition = Vector2.new(
        0,
        math.max(0, LogsFrame.AbsoluteCanvasSize.Y)
    )
end

