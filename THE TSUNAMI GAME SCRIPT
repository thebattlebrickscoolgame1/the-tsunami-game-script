-- OBJECT CLEANUP
-- =========================================================

createSection(CONFIG.SECTION_OBJECT_CLEANUP)

local deletePoolButton = createButton(
    CONFIG.TEXT.DELETE_POOL_BUTTON
)

deletePoolButton.MouseButton1Click:Connect(function()

    local found = 0
    local removed = 0

    for _, object in ipairs(game:GetDescendants()) do

        if isTarget(object.Name) then

            found += 1

            local success = pcall(function()
                object:Destroy()
            end)

            if success then
                removed += 1
            end
        end
    end

    addLog(
        "Cleanup found " .. found .. " objects and removed " .. removed,
        false
    )
end)

