local function formatAssetId(id)
    id = tostring(id or "")

    if id == "" then
        return ""
    end

    if string.find(id, "rbxassetid://", 1, true) then
        return id
    end

    local numericId = string.match(id, "%d+")

    if numericId then
        return "rbxassetid://" .. numericId
    end

    return id
end

local function isTarget(name)
    for _, target in ipairs(CONFIG.TARGETS) do
        if name == target then
            return true
        end
    end

    return false
end

