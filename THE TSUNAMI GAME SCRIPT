            if speedPurchaseEnabled then
                pcall(function()
                    game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("PurchaseSpeed"):FireServer(CONFIG.SPEED_PURCHASE_AMOUNT)
                end)
            end
            task.wait(CONFIG.AUTOMATION_DELAY)
        end
    end)

    local carryPurchaseButton = createButton(CONFIG.TEXT.CARRY_PURCHASE_TOGGLE_OFF)
    carryPurchaseButton.MouseButton1Click:Connect(function()
        carryPurchaseEnabled = not carryPurchaseEnabled
        if carryPurchaseEnabled then
            carryPurchaseButton.Text = CONFIG.TEXT.CARRY_PURCHASE_TOGGLE_ON
        else
            carryPurchaseButton.Text = CONFIG.TEXT.CARRY_PURCHASE_TOGGLE_OFF
        end
        addLog("Auto Carry Purchase: " .. (carryPurchaseEnabled and "ON" or "OFF"), false)
    end)

    task.spawn(function()
        while ScreenGui.Parent do
            if carryPurchaseEnabled then
                pcall(function()
                    game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("PurchaseCarry"):FireServer()
                end)
            end
            task.wait(CONFIG.AUTOMATION_DELAY)
        end
    end)

    local rebirthButton = createButton(CONFIG.TEXT.REBIRTH_TOGGLE_OFF)
    rebirthButton.MouseButton1Click:Connect(function()
        rebirthEnabled = not rebirthEnabled
        if rebirthEnabled then
            rebirthButton.Text = CONFIG.TEXT.REBIRTH_TOGGLE_ON
        else
            rebirthButton.Text = CONFIG.TEXT.REBIRTH_TOGGLE_OFF
        end
        addLog("Auto Rebirth: " .. (rebirthEnabled and "ON" or "OFF"), false)
    end)

    task.spawn(function()
        while ScreenGui.Parent do
            if rebirthEnabled then
                pcall(function()
                    game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("RequestRebirth"):FireServer()
                end)
            end
            task.wait(CONFIG.AUTOMATION_DELAY)
        end
    end)

    -- Utility Section
    createSection(CONFIG.SECTION_UTILITY)

    local logsButton = createButton(CONFIG.TEXT.OPEN_LOGS_BUTTON)
    logsButton.MouseButton1Click:Connect(function()
        createLogs()
        if LogsFrame then
            LogsFrame.Visible = true
        end
    end)

    createLabel(CONFIG.TEXT.FOV_LABEL)
    local fovBox = createTextBox(CONFIG.TEXT.FOV_PLACEHOLDER)
    fovBox.Text = "70"

    local setFovButton = createButton(CONFIG.TEXT.SET_FOV_BUTTON)
    setFovButton.MouseButton1Click:Connect(function()
        local value = tonumber(fovBox.Text)
        if not value then
            addLog("Invalid FOV value", true)
            return
        end
        workspace.CurrentCamera.FieldOfView = value
        addLog("FOV set to " .. value, false)
    end)

    createLabel(CONFIG.TEXT.JUMPPOWER_LABEL)
    local jumpPowerBox = createTextBox(CONFIG.TEXT.JUMPPOWER_PLACEHOLDER)
    jumpPowerBox.Text = "50"

    local setJumpPowerButton = createButton(CONFIG.TEXT.SET_JUMPPOWER_BUTTON)
    setJumpPowerButton.MouseButton1Click:Connect(function()
        local value = tonumber(jumpPowerBox.Text)
        if not value then
            addLog("Invalid JumpPower value", true)
            return
        end
        local character = LocalPlayer.Character
        if not character then
            addLog("Character not found", true)
            return
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            addLog("Humanoid not found", true)
            return
        end
        humanoid.UseJumpPower = true
        humanoid.JumpPower = value
        addLog("JumpPower set to " .. value, false)
    end)

    -- Customization Section
    createSection(CONFIG.SECTION_CUSTOMIZATION)
    createLabel(CONFIG.TEXT.BACKGROUND_ID_LABEL)

    local backgroundIdBox = createTextBox(CONFIG.TEXT.BACKGROUND_ID_PLACEHOLDER)
    local applyBackgroundButton = createButton(CONFIG.TEXT.APPLY_BACKGROUND_BUTTON)
    applyBackgroundButton.MouseButton1Click:Connect(function()
        local id = formatAssetId(backgroundIdBox.Text)
        if id == "" then
            addLog("Invalid background image ID", true)
            return
        end
        BackgroundImage.Image = id
        addLog("GUI background changed", false)
    end)

    createLabel(CONFIG.TEXT.BACKGROUND_TRANSPARENCY_LABEL)
    local transparencyBox = createTextBox(CONFIG.TEXT.BACKGROUND_TRANSPARENCY_PLACEHOLDER)
    transparencyBox.Text = tostring(CONFIG.GUI_BACKGROUND_TRANSPARENCY)

    local applyTransparencyButton = createButton(CONFIG.TEXT.APPLY_TRANSPARENCY_BUTTON)
    applyTransparencyButton.MouseButton1Click:Connect(function()
        local value = tonumber(transparencyBox.Text)
        if not value then
            addLog("Invalid transparency value", true)
            return
        end
        value = math.clamp(value, 0, 1)
        BackgroundImage.ImageTransparency = value
        addLog("Background transparency set to " .. value, false)
    end)

    -- Close Button Action
    CloseButton.MouseButton1Click:Connect(function()
        speedPurchaseEnabled = false
        carryPurchaseEnabled = false
        rebirthEnabled = false
        if customSound then
            pcall(function()
                customSound:Stop()
                customSound:Destroy()
            end)
            customSound = nil
        end
        if LogsFrame then
            LogsFrame:Destroy()
            LogsFrame = nil
        end
        ScreenGui:Destroy()
    end)
end
